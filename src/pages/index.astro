---
import raniko001 from "@assets/images/raniko001.png";
import raniko002 from "@assets/images/raniko002.png";
import raniko003 from "@assets/images/raniko003.jpg";
import raniko004 from "@assets/images/raniko004.png";
import Heading from "@components/Heading.astro";
import ImageModal from "@components/ImageModal.astro";
import ProfileCard from "@components/ProfileCard.astro";
import FanartGrid from "@components/FanartGrid.astro";
import MaterialGrid from "@components/MaterialGrid.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { fanarts } from "@data/fanarts";

const materials = [
  { src: raniko001, alt: "立ち絵" },
  { src: raniko002, alt: "作画メモ" },
  { src: raniko003, alt: "日常" },
  { src: raniko004, alt: "陣営" },
];

const tags = [...new Set(fanarts.flatMap((f) => f.tags))];
---

<BaseLayout title="らにこさんのホームページ">
  <div class="page">
    <section id="top" class="top-grid" aria-label="トップ">
      <ProfileCard />

      <section id="materials" class="section" aria-label="資料集">
        <MaterialGrid items={materials} />
      </section>
    </section>

    <section id="otegaki" class="section">
      <div>
        <Heading tag="h2" class="section-title">おてがき</Heading>
        <p class="caption">
          描いて頂いた絵をまとめています。ありがとうございます！
        </p>
      </div>

      <div class="controls">
        <label class="sensitive-checkbox">
          <input type="checkbox" id="sensitive-toggle" />
          センシティブな画像を表示
        </label>

        <div class="filter-tabs" role="tablist" aria-label="タグで絞り込み">
          <button
            class="filter-tab active"
            data-tag="all"
            role="tab"
            aria-selected="true"
          >
            すべて
          </button>
          {
            tags.map((tag) => (
              <button
                class="filter-tab"
                data-tag={tag}
                role="tab"
                aria-selected="false"
              >
                {tag}
              </button>
            ))
          }
        </div>
      </div>

      <FanartGrid fanarts={fanarts} />
    </section>
  </div>

  <ImageModal />
</BaseLayout>

<script>
  import {
    IMAGE_MODAL_OPEN_EVENT,
    type ModalImage,
  } from "@components/imageModal";

  const STORAGE_KEY = "otegaki-sensitive";

  function initOtegaki() {
    const grid = document.querySelector(".grid");
    if (!grid) return;

    const sensitiveCheckbox = document.getElementById(
      "sensitive-toggle",
    ) as HTMLInputElement;
    const filterTabs = document.querySelector(".filter-tabs") as HTMLElement;
    const allCards = () =>
      Array.from(grid.querySelectorAll(".card")) as HTMLElement[];

    // --- Sensitive toggle ---
    function setSensitiveState(show: boolean) {
      if (show) {
        document.documentElement.dataset.sensitiveShown = "";
      } else {
        delete document.documentElement.dataset.sensitiveShown;
      }
      document
        .querySelectorAll<HTMLElement>(
          ".card[data-sensitive='true'] .card-image-link",
        )
        .forEach((el) => (el.tabIndex = show ? 0 : -1));
      document
        .querySelectorAll<HTMLElement>(
          ".card[data-sensitive='true'] .blur-overlay",
        )
        .forEach((el) => (el.tabIndex = show ? -1 : 0));
    }

    const initialShown =
      document.documentElement.dataset.sensitiveShown !== undefined;
    sensitiveCheckbox.checked = initialShown;
    setSensitiveState(initialShown);

    sensitiveCheckbox.addEventListener("change", () => {
      localStorage.setItem(STORAGE_KEY, String(sensitiveCheckbox.checked));
      setSensitiveState(sensitiveCheckbox.checked);
    });

    // --- Card tag click ---
    function updateFilterUI() {
      filterTabs.querySelectorAll(".filter-tab").forEach((t) => {
        const el = t as HTMLElement;
        const isActive = el.dataset.tag === activeTag;
        el.classList.toggle("active", isActive);
        el.setAttribute("aria-selected", String(isActive));
      });
      document.querySelectorAll<HTMLElement>(".card-tag").forEach((el) => {
        el.classList.toggle("active", el.dataset.tag === activeTag);
      });
    }

    // --- Grid click delegation ---
    grid.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // Card tag click → filter
      const cardTag = target.closest(".card-tag") as HTMLElement | null;
      if (cardTag) {
        const tag = cardTag.dataset.tag!;
        activeTag = activeTag === tag ? "all" : tag;
        updateFilterUI();
        applyFilter();
        return;
      }

      // Blur overlay → toggle global sensitive state
      const overlay = target.closest(".blur-overlay");
      if (overlay) {
        sensitiveCheckbox.checked = true;
        localStorage.setItem(STORAGE_KEY, "true");
        setSensitiveState(true);
        const btn = (overlay as HTMLElement)
          .closest(".card")
          ?.querySelector<HTMLElement>(".card-image-link");
        btn?.focus();
        return;
      }

      // Carousel controls → handled by CardCarousel
      if (target.closest(".carousel-btn") || target.closest(".carousel-dot"))
        return;

      // Image click → open modal
      const imageLink = target.closest(
        ".card-image-link",
      ) as HTMLElement | null;
      if (!imageLink) return;

      const card = imageLink.closest(".card") as HTMLElement;
      if (!card) return;

      const slideIndex = parseInt(imageLink.dataset.slideIndex || "0", 10);
      const sensitiveShown =
        document.documentElement.dataset.sensitiveShown !== undefined;

      const visibleCards = Array.from(
        grid.querySelectorAll<HTMLElement>(".card"),
      ).filter((c) => {
        if (c.style.display === "none") return false;
        if (c.dataset.sensitive === "true" && !sensitiveShown) return false;
        return true;
      });

      const images: ModalImage[] = [];
      let flatIndex = 0;

      for (const c of visibleCards) {
        const imgEls = c.querySelectorAll<HTMLImageElement>(
          ".carousel-slide .card-image-link img",
        );
        const isTargetCard = c === card;
        imgEls.forEach((img, i) => {
          images.push({ url: img.src });
          if (isTargetCard && i === slideIndex) {
            flatIndex = images.length - 1;
          }
        });
      }

      document.dispatchEvent(
        new CustomEvent(IMAGE_MODAL_OPEN_EVENT, {
          detail: { images, startIndex: flatIndex },
        }),
      );
    });

    // --- Tag filter ---
    let activeTag = "all";

    function applyFilter() {
      allCards().forEach((card) => {
        const tags = (card.dataset.tags || "").split(" ").filter(Boolean);
        card.style.display =
          activeTag === "all" || tags.includes(activeTag) ? "" : "none";
      });
    }

    filterTabs?.addEventListener("click", (e) => {
      const tab = (e.target as HTMLElement).closest(
        ".filter-tab",
      ) as HTMLElement;
      if (!tab) return;

      const tag = tab.dataset.tag!;
      activeTag = activeTag === tag ? "all" : tag;

      updateFilterUI();
      applyFilter();
    });
  }

  function init() {
    initOtegaki();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* --- 縦積み（プロフィール上 / 資料集下） --- */
  .top-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* --- Section common --- */
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .section-title {
    font-size: 1.5rem;
  }

  /* --- おてがき --- */
  .caption {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .sensitive-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    border: 1px solid var(--color-interactive-border);
    border-radius: var(--radius-image);
    padding: 0.375rem 0.75rem;
    transition: border-color var(--transition-fast);
  }

  .sensitive-checkbox:hover {
    border-color: var(--color-interactive-border-hover);
  }

  .sensitive-checkbox:has(input[type="checkbox"]:checked) {
    border-color: var(--color-accent);
  }

  .sensitive-checkbox input[type="checkbox"] {
    accent-color: var(--color-accent);
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .filter-tab {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-interactive-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
    font-family: inherit;
  }

  .filter-tab:hover {
    border-color: var(--color-interactive-border-hover);
  }

  .filter-tab.active {
    background: var(--color-accent);
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .page {
      gap: var(--space-md);
    }

    .top-grid {
      gap: var(--space-md);
    }
  }
</style>
