---
import type { Fanart } from "@data/fanarts";
import FanartCard from "./FanartCard.astro";

interface Props {
  fanarts: Fanart[];
}

const { fanarts } = Astro.props;
---

<div class="grid">
  {
    fanarts.map((fanart, index) => (
      <FanartCard fanart={fanart} lcp={index === 0} />
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--space-sm);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
