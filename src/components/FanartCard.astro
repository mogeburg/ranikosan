---
import { Image } from "astro:assets";
import type { Fanart } from "@data/fanarts";

interface Props {
  fanart: Fanart;
  lcp?: boolean;
}

const { fanart, lcp } = Astro.props;
const isYoutube =
  fanart.relatedUrl?.includes("youtube.com") ||
  fanart.relatedUrl?.includes("youtu.be");
const linkLabel = fanart.relatedUrl ? (isYoutube ? "配信URL" : "元URL") : null;
const tagsAttr = fanart.tags.join(" ");
const multiple = fanart.images.length > 1;
---

<article
  class="card"
  data-sensitive={fanart.sensitive ? "true" : undefined}
  data-tags={tagsAttr}
>
  <div class="card-image-wrapper">
    <div class="carousel" data-carousel={multiple ? "" : undefined}>
      <div class="carousel-track">
        {
          fanart.images.map((image, i) => (
            <div class="carousel-slide">
              <button
                type="button"
                class="card-image-link"
                data-slide-index={i}
                aria-label="画像を拡大表示"
                tabindex={fanart.sensitive ? -1 : undefined}
              >
                <Image
                  src={image}
                  alt=""
                  class="card-image"
                  loading={i === 0 ? (lcp ? "eager" : "lazy") : "lazy"}
                  fetchpriority={i === 0 && lcp ? "high" : undefined}
                />
              </button>
            </div>
          ))
        }
      </div>
      {
        multiple && (
          <>
            <button
              type="button"
              class="carousel-btn carousel-btn--prev"
              aria-label="前の画像"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-btn carousel-btn--next"
              aria-label="次の画像"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
            <div class="carousel-dots" role="tablist" aria-label="画像の選択">
              {fanart.images.map((_, i) => (
                <button
                  type="button"
                  class="carousel-dot"
                  data-slide={i}
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-label={`${i + 1}枚目`}
                />
              ))}
            </div>
          </>
        )
      }
    </div>
    {
      fanart.tags.length > 0 && (
        <div class="card-tags">
          {fanart.tags.map((tag) => (
            <button type="button" class="card-tag" data-tag={tag}>
              {tag}
            </button>
          ))}
        </div>
      )
    }
    {
      fanart.sensitive && (
        <button
          type="button"
          class="blur-overlay"
          aria-label="センシティブな画像を表示"
        >
          <span class="blur-overlay-note">センシティブな内容を含みます</span>
          <span class="blur-overlay-text">クリックで表示</span>
        </button>
      )
    }
  </div>
  <div class="card-meta">
    <span class="card-author">{fanart.author || "もげ"}</span>
    <time class="card-date">{fanart.postedAt}</time>
    {
      linkLabel && (
        <a
          href={fanart.relatedUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-link"
        >
          {linkLabel}
        </a>
      )
    }
  </div>
</article>

<script>
  class CardCarousel {
    root: HTMLElement;
    track: HTMLElement;
    prevBtn: HTMLButtonElement | null;
    nextBtn: HTMLButtonElement | null;
    dots: HTMLElement[];
    slides: HTMLElement[];
    current: number = 0;

    constructor(root: HTMLElement) {
      this.root = root;
      this.track = root.querySelector(".carousel-track")!;
      this.prevBtn = root.querySelector<HTMLButtonElement>(
        ".carousel-btn--prev",
      );
      this.nextBtn = root.querySelector<HTMLButtonElement>(
        ".carousel-btn--next",
      );
      this.dots = Array.from(root.querySelectorAll(".carousel-dot"));
      this.slides = Array.from(root.querySelectorAll(".carousel-slide"));

      this.track.addEventListener("scroll", () => this.onScroll(), {
        passive: true,
      });

      this.prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.goTo(this.current - 1);
      });

      this.nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.goTo(this.current + 1);
      });

      this.dots.forEach((dot, i) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          this.goTo(i);
        });
      });

      this.update();
    }

    goTo(index: number) {
      const slide = this.slides[index];
      if (!slide) return;
      this.track.scrollTo({
        left: slide.offsetLeft - this.track.offsetLeft,
        behavior: "smooth",
      });
    }

    onScroll() {
      const slideWidth = this.track.clientWidth;
      if (slideWidth === 0) return;
      const index = Math.round(this.track.scrollLeft / slideWidth);
      if (index !== this.current) {
        this.current = index;
        this.update();
      }
    }

    update() {
      if (this.prevBtn) this.prevBtn.disabled = this.current === 0;
      if (this.nextBtn)
        this.nextBtn.disabled = this.current === this.slides.length - 1;
      this.dots.forEach((dot, i) => {
        const active = i === this.current;
        dot.classList.toggle("active", active);
        dot.setAttribute("aria-selected", String(active));
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      document
        .querySelectorAll<HTMLElement>(".carousel[data-carousel]")
        .forEach((el) => new CardCarousel(el));
    });
  } else {
    document
      .querySelectorAll<HTMLElement>(".carousel[data-carousel]")
      .forEach((el) => new CardCarousel(el));
  }
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-hard);
  }

  .card-image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-border);
    border-bottom: 2px solid var(--color-border);
  }

  /* --- Carousel --- */
  .carousel {
    width: 100%;
    height: 100%;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    height: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    height: 100%;
  }

  /* --- Carousel nav buttons --- */
  .carousel-btn {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
    padding: 0;
    font: inherit;
    line-height: 1;
    transition: background var(--transition-fast);
  }

  .carousel-btn::after {
    content: "";
    position: absolute;
    inset: -0.75rem;
    border-radius: inherit;
  }

  .carousel-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .carousel-btn:hover:not(:disabled) {
    background: rgba(0, 0, 0, 0.75);
  }

  .carousel-btn--prev {
    left: 0.375rem;
  }

  .carousel-btn--next {
    right: 0.375rem;
  }

  /* --- Dots --- */
  .carousel-dots {
    position: absolute;
    bottom: 0.375rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.375rem;
    z-index: 3;
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.4);
    cursor: pointer;
    padding: 0;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .carousel-dot.active {
    background: #fff;
    border-color: #fff;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.6);
  }

  /* --- Tags --- */
  .card-tags {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    z-index: 2;
    pointer-events: none;
  }

  .card-tag {
    pointer-events: auto;
    padding: 0.125rem 0.5rem;
    border: none;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.6875rem;
    font-family: inherit;
    cursor: pointer;
    transition: background var(--transition-fast);
    line-height: 1.4;
  }

  .card-tag:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .card-tag.active {
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  /* --- Image link --- */
  .card-image-link {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .card-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      filter var(--transition-fast),
      opacity var(--transition-fast);
  }

  .card-image-link:hover img {
    opacity: var(--image-hover-opacity);
  }

  /* --- Sensitive blur --- */
  .card[data-sensitive="true"] .card-image-link img {
    filter: blur(24px);
  }

  .card[data-sensitive="true"] .blur-overlay {
    display: flex;
  }

  :global(html[data-sensitive-shown])
    .card[data-sensitive="true"]
    .card-image-link
    img {
    filter: none;
  }

  :global(html[data-sensitive-shown])
    .card[data-sensitive="true"]
    .blur-overlay {
    display: none;
  }

  /* When sensitive is blurred: disable carousel controls + scroll */
  .card[data-sensitive="true"] .carousel-btn,
  .card[data-sensitive="true"] .carousel-dots {
    display: none;
  }

  .card[data-sensitive="true"] .carousel-track {
    overflow: hidden;
    pointer-events: none;
  }

  /* When sensitive is shown: restore carousel */
  :global(html[data-sensitive-shown])
    .card[data-sensitive="true"]
    .carousel-btn {
    display: flex;
  }

  :global(html[data-sensitive-shown])
    .card[data-sensitive="true"]
    .carousel-dots {
    display: flex;
  }

  :global(html[data-sensitive-shown])
    .card[data-sensitive="true"]
    .carousel-track {
    overflow-x: auto;
    pointer-events: auto;
  }

  .blur-overlay {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    gap: 0.5rem;
    cursor: pointer;
    z-index: 1;
    user-select: none;
    padding: 0;
    border: none;
    font: inherit;
    color: inherit;
    width: 100%;
  }

  .blur-overlay-note {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.75rem;
    text-align: center;
  }

  .blur-overlay-text {
    color: #fff;
    font-size: 0.875rem;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.55);
  }

  /* --- Meta --- */
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
  }

  .card-author {
    font-weight: 600;
    flex-shrink: 0;
  }

  .card-date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .card-link {
    font-weight: bold;
    font-size: 0.75rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .card-link:hover {
    text-decoration: underline;
  }
</style>
